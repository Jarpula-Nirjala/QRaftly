{
  "name": "qraftly",
  "version": "1.0.0",
  "description": "QR codes from scratch: a hand-written QR encoder and decoder, dynamic codes with scan analytics, context rules, secure codes, event tickets, signed certificates and bulk generation.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev:server": "node --watch server/main.ts",
    "dev:client": "vite",
    "build": "vite build",
    "start": "node --max-old-space-size=256 server/main.ts",
    "test": "node --test \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "e2e": "node e2e/smoke.ts"
  },
  "dependencies": {
    "express": "^5.3.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsqr": "^1.4.0",
    "lucide-react": "1.49.0",
    "playwright-core": "1.63.0",
    "pngjs": "^7.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
